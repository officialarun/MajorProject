<% layout("/layouts/boilerplate") %>
<body>
    
    <h3 style="margin-top: 1rem;"><b><%= listing.title %></b> <br></h3>
    <div class="row">
        <div class="col-8 offset-2">
            <div class="card">
                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
                <div class="card-body">
                    <!-- <p class="card-text">
                        Some quick example text to build on the card title and make up the bulk of the card's content.
                    </p> -->
                    <h5>Listed by: <%= listing.owner.username %></h3>
                    <br>
                    <%= listing.description %> <br>
                    &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
                    <%= listing.location %> <br>
                    <%= listing.country %>


                </div>

                <!-- <form action="/listings/new" method="GET">
                    <button class="btn btn-dark">Create New Listing</button>
                </form> -->
                <br>                
                <%if (currUser && listing.owner && listing.owner._id && currUser._id && listing.owner._id.toString() === currUser._id.toString()){ %>
                <div class="butt">
                    <div class="butt1">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark show-btn">Edit this listing</a>
                    </div>  
                    <div class="butt3">
                        <form action="/listings/payment/<%=listing._id%>/createOrder" method="POST" >
                            <button class="btn btn-dark" id="pay-now-btn" data-listing-id="<%= listing._id %>">Book Now</button>
                        </form>
                    </div>                  
                    <div class="butt2">
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button class="btn btn-dark">Delete this listing</button>
                        </form>
                    </div>                    
                </div>
                <% } %>
                <%if (currUser) { %>
                <div class="butt">
                            <div class="butt3">
                                <form action="/listings/payment/<%=listing._id%>/createOrder" method="POST" >
                                    <button class="btn btn-dark" id="pay-now-btn" data-listing-id="<%= listing._id %>">Book Now</button>
                                </form>
                            </div>                  
                                     
                    </div>
                <% } %>
              
                
            </div>
        </div>

        <div class="col-8 offset-2">
            
            <% if(currUser){ %>
                <hr>
            <h4>Leave a review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="POST">
                <!-- <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                </div> -->

                <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <legend>First rating:</legend>
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5"name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
               
                
                <div class="mb-3">
                    <label for="comments" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control" required></textarea>
                </div>
                <br>
                <button class="btn btn-dark add-btn" class="form-control">Submit</button>
                <br>
                <br>
            </form>
            <% } %>
        </div>
        <% console.log("Reviews Array:", listing.reviews); %>
        <% if(listing.reviews.length>0){ %>
        <section id="reviews">
            <div class="reviews-container">
                <h2>What People Are Saying</h2>
                <div class="reviews-slider">
                    <% for(review of listing.reviews){ %>
                        <div class="review-box" >
                            <p>@<%= review.author.username %></p>
                            <p><%= review.comment %></p>
                            <!-- for (let i = 0; i < review.rating; i++) { 
                                <i class="fa-solid fa-star" style="color: #FFD43B;"></i>
                            }  -->
                                <p class="starability-result" style="margin: auto;"  data-rating="<%= review.rating %>"></p>
                                <!-- <hr style="width:50%; align-self: center;"> -->
                                 <br>
                                <hr style="width: 50%; margin: auto; border: 1px solid #ccc;">
                                <br>
                            <form action="/listings/<%= listing._id%>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                                <button class="btn btn-sm btn-dark">Delete</button>
                            </form>
                        </div>
                    <% }%>
                    
                </div>
            </div>
        </section>
        <% } %>

        <div class="col-8 offset-2 mb-3">
            <h3>Where you'll be</h3>
            <div id="map"></div>
        </div>
        <script>
            const mapToken="<%= process.env.MAP_TOKEN %>";
            // const listing=JSON.parse("<%- JSON.stringify(listing) %>");
            const listing=<%- JSON.stringify(listing) %>
            // console.log(coordinates);
        </script>
        <script src="/js/map.js"></script>
       
    </div>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        document.getElementById("pay-now-btn").addEventListener("click", async function(event) {
            event.preventDefault();  // ✅ Stop default form submission
            const listingId = this.getAttribute("data-listing-id");
    
            try {
                // 🔹 Call your backend to create an order
                const response = await fetch(`/listings/payment/${listingId}/createOrder`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                });
    
                const data = await response.json();
    
                if (!data.success) {
                    alert("❌ Error creating order. Please try again!");
                    return;
                }
    
                // 🔹 Initialize Razorpay Payment
                const options = {
                    key: data.key_id,  // Your Razorpay Key ID
                    amount: data.amount,  // Amount in paise
                    currency: "INR",
                    name: data.name,
                    description: data.description,
                    order_id: data.order_id,
                    handler: async function(response) {
                        alert("✅ Payment Successful! Payment ID: " + response.razorpay_payment_id);

                        const paymentData = {
                            order_id: data.order_id,
                            payment_id: response.razorpay_payment_id,
                            signature: response.razorpay_signature
                        };

                        console.log(paymentData);

                        // 🔹 Send payment details to backend
                        const confirmResponse = await fetch(`/listings/payment/confirm`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(paymentData)
                        });

                        const confirmData = await confirmResponse.json();
                        if (confirmData.success) {
                            alert("✅ Payment recorded successfully!");
                        } else {
                            alert("⚠️ Error storing payment. Contact support.");
                        }

                        window.location.href = "/listings"; // Redirect after payment
                    }
                    ,
                    prefill: {
                        name: data.name,
                        email: data.email,
                        contact: data.contact
                    },
                    theme: {
                        color: "#3399cc"
                    },
                    modal: {
                        ondismiss: function() { 
                            alert("⚠️ Payment Cancelled! Returning to the same page.");
                            window.location.reload();  // ✅ Reload same page when user closes Razorpay modal
                        }
                    }
                };
    
                const razorpay = new Razorpay(options);
                razorpay.open();  // Open Razorpay UI
    
            } catch (error) {
                console.error("❌ Payment error:", error);
                alert("Something went wrong! Please try again.");
            }
        });
    </script>
    

    
</body>

